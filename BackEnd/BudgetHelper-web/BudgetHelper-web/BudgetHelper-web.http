@BudgetHelper_web_HostAddress = http://localhost:3000

# GET a single receipt by ID
GET {{BudgetHelper_web_HostAddress}}/api/receipts/d1e19dcf-f7b1-4fb1-8d83-ed5cf8046f83
Accept: application/json

###

# GET all api/receipts
GET {{BudgetHelper_web_HostAddress}}/api/receipts
Accept: application/json

###

# POST a new receipt
POST {{BudgetHelper_web_HostAddress}}/api/receipts
Content-Type: application/json

{
  "id": "",
  "date": "2024-01-15T00:00:00",
  "amount": 45.99
}

###

# POST extract receipt
POST {{BudgetHelper_web_HostAddress}}/api/receipt-extraction
Content-Type: application/json

{
  "base64Image": ""
}

###

# PUT (update) a receipt
PUT {{BudgetHelper_web_HostAddress}}/api/receipts/receipt-{{newGuid}}
Content-Type: application/json

{
  "id": "",
  "date": "2024-01-16T00:00:00",
  "amount": 55.50
}

###

# DELETE a receipt
DELETE {{BudgetHelper_web_HostAddress}}/api/receipts/1

###

# GET multiple api/receipts by IDs
GET {{BudgetHelper_web_HostAddress}}/api/receipts
Accept: application/json

###

# POST a new budget
POST {{BudgetHelper_web_HostAddress}}/api/budgets
Content-Type: application/json

{
  "monthlyLimit": 99
}

###

# GET the existing budget
GET {{BudgetHelper_web_HostAddress}}/api/budgets
Content-Type: application/json
